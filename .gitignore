# ====================================================================
# 1. C COMPILER OUTPUTS & BUILD ARTIFACTS
# ====================================================================
# Object files (compiled intermediates)
*.o
*.obj

# Dynamic & Static Libraries
*.a
*.lib
*.so
*.dylib
*.dll

# Debug Symbol Files
*.dSYM/
*.gch
*.d

# Common default compiler output names
a.out
*.out
*.exe

# ====================================================================
# 2. LABELED PROJECT BINARIES (To avoid extensionless file tracking)
# ====================================================================
# Nothing to see here as of now.

# ====================================================================
# 3. INTERPRETER & VM TEMP FILES
# ====================================================================
# Python cache (test scripts for servers/VM)
__pycache__/
*.pyc

# Local log files generated by testing databases
*.log
*.db
*.dat

# ====================================================================
# 4. ENVIRONMENT & WORKSPACE CLUTTER
# ====================================================================
# Neovim / Vim swap, backup, and undo history files
*.swp
*.swo
*~
.netrwhist

# Neovim local LSP / Shada / persistent undo histories (if generated locally)
.nvim/
.lua/
shada/

# Operating System specific files
.DS_Store
Thumbs.db
